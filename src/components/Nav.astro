---
import NavLink from "./NavLink.astro"
import {
  aboutMeId,
  workId,
  personalProjectsId,
  contactId,
} from "../constants.ts"
---

<nav
  class="bg-mainBackground text-mainText fixed inset-0 z-10 mx-auto h-fit max-w-[1440px]"
>
  <div
    class="border-niceGreen child-hover:text-niceBlue mx-auto flex w-[91%] justify-center gap-6 border-b p-4 md:w-[55%]"
  >
    <NavLink href={aboutMeId}>About</NavLink>
    <NavLink href={workId}>Work</NavLink>
    <NavLink href={personalProjectsId}>Projects</NavLink>
    <NavLink href={contactId}>Contact</NavLink>
  </div>
</nav>
